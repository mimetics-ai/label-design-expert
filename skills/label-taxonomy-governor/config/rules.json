{
  "version": "1.2.0",
  "note": "规则可配置。项目专有名词请放进 key_aliases，不要写进脚本。分域禁用词按属性认定结果选用，禁止一把梭。工业化学品域无专用禁用词表，脚本只启用通用词表；化学品强制标注的核查走 references/domain-b-chemical-label.md 并标『依据：待核实』。",
  "naming": {
    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "max_length": 40,
    "reserved_words": ["misc", "other", "unknown", "temp", "test", "etc", "miscellaneous"]
  },
  "hierarchy": {
    "max_depth": 3
  },
  "coverage": {
    "min_coverage": 0.95,
    "min_dimension_usage": 0.20,
    "max_long_tail_ratio": 0.30,
    "max_single_tag_rate": 0.20,
    "min_value_hits": 2
  },
  "key_aliases": {
    "customercount": "customers",
    "servedenterprises": "customers",
    "integrity": "integritylevel",
    "expectedintegrity": "integritylevel"
  },
  "banned_label_words_scope": {
    "化妆品": ["防蚊", "驱蚊", "纯植物", "纯天然", "根除", "速效"],
    "农药": ["根除", "速效", "铲除", "高产", "增产", "儿童", "孕妇", "过敏者"],
    "通用": ["国家级", "最高级", "最佳", "第一品牌"]
  },
  "verdicts": ["通过", "不通过", "需人工复核"],
  "drift_types": ["值漂移", "名漂移", "范围漂移", "版本陈旧"],
  "drift_priority": ["值漂移", "名漂移", "范围漂移", "版本陈旧"]
}
